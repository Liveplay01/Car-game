{"nodes": [{"id": "foundation_document", "label": "FOUNDATION.md (Spielregeln und Grundlagen)", "file_type": "document", "source_file": "FOUNDATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regeln mit Startwerten, Motion/Bild-Grunds\u00e4tze, Architektur; weicht das Dokument vom Code ab, gilt der Code (config.ts)."}, {"id": "foundation_base_loop", "label": "Basis / Kernloop", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "Abschnitt 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Der Kernloop muss f\u00fcr sich allein Spa\u00df machen; alles andere dockt an, ohne die Basis umzubauen. Eine Schicht = 15 Autos, gut gespielt ca. 20 s."}, {"id": "foundation_stack", "label": "Stack und Backend-Grenze", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kein Backend f\u00fcrs Spiel; nur die optionale Rangliste spricht mit einem eigenen Dienst; Multiplayer direkt per WebRTC \u00fcber PeerJS."}, {"id": "foundation_target_devices", "label": "Zielger\u00e4te und Performance-Ma\u00dfstab", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kleinster Bildschirm 375x667; \u00e4ltere Mittelklasse-Handys m\u00fcssen 60 fps halten; fester Simulationstakt wegen 60-144 Hz."}, {"id": "foundation_playfield", "label": "Spielfeld (Hochformat, Ring mit Zufahrten, S\u00fcd = Spieler)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spielwelt \u00fcberall gleich gro\u00df, nur die Kamera zoomt, damit Timing und Highscores ger\u00e4teunabh\u00e4ngig sind; 4 Zufahrten zum Start, bis zu 8 in 16 Steckpl\u00e4tzen (22,5 Grad), Platz 0 geh\u00f6rt dem Spieler."}, {"id": "foundation_tap_flow", "label": "Tap-Ablauf (feste Einf\u00e4delbahn 0,5 s)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feste Einf\u00e4deldauer macht das Timing lernbar; \u00e4ndert sich das Ringtempo, l\u00e4uft das Einf\u00e4deln im selben Verh\u00e4ltnis (Fund des Balancing-Bots), ein Tight Fit wird nie zum Crash."}, {"id": "foundation_held_tap", "label": "Kein Tap-Cooldown, gehaltener Tap, Nachr\u00fccken ohne Ruck", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eigene Autos bewerten sich nicht gegenseitig (sonst w\u00e4re schnelles Tippen ein Tight-Fit-Automat); h\u00f6chstens ein Tap wird gehalten; PlayerQueue.approach/Pass, passClearance 4."}, {"id": "foundation_scoring", "label": "Bewertung einer Einf\u00e4delung (Crash, Tight Fit, Sauber)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Abstand wird in Sekunden gemessen, damit die Bewertung bei steigendem Rush-Hour-Tempo fair bleibt; Tight Fit < 0,12 s = 200 x Multiplikator, Sauber 100 x, Crash -250."}, {"id": "foundation_jammed_rule", "label": "Eingekrochen (JAMMED, creepPace)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "01.10.2026: Dauertippen schob nach einem Crash eine Kolonne in den gebremsten Ring und hielt die St\u00f6rung am Leben (Unlimited-Rekord ohne zu spielen); getimt wird nichts, also gibt es 0 Punkte."}, {"id": "foundation_sloppy_window", "label": "sloppyWindow (Cut off!, standardm\u00e4\u00dfig aus)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tight Fit soll direkt an der Crash-Kante liegen; eine zweite Strafzone w\u00fcrde riskantes Spiel unattraktiver machen; Entscheidung im Playtest."}, {"id": "foundation_combo_multiplier", "label": "Combo-Multiplikator (x1 bis x6)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "foundation_shift", "label": "Die Schicht (15 Autos, keine Uhr)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Druck ohne Uhr: Dichte und Tempo steigen mit der Zeit (rampSeconds 20), wer wartet bekommt mehr Verkehr; Abschlussbonus +1000; ein Tap startet die n\u00e4chste Schicht."}, {"id": "foundation_rush_hour", "label": "Rush Hour (letzte 4 Autos, Tempo 135 %, Punkte x2)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "foundation_shift_flow", "label": "Schichtstart und Schichtende (World.nextShift)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flie\u00dfender \u00dcbergang: Verkehr bleibt im Ring, der erste Tap startet die Schicht; Ergebnis ohne Men\u00fc, die ersten 0,4 s gesperrt."}, {"id": "foundation_levels", "label": "Level-System (Autozahl 10-30, entsch\u00e4rfte Level 1-4)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Geschaffte Schicht = Level h\u00f6her, verlorene wird wiederholt; Config pro Schicht aus Basiswerten plus Modifikatoren (forLevel in levels.ts)."}, {"id": "foundation_crashes", "label": "Fehler: Crashes (maxStrikes 1, maxPoliceCrashes 3)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Klassisch harter Car-Circle-Modus: Crash eines normalen Autos beendet die Schicht; Polizeiautos haben eigenes Budget von 3."}, {"id": "foundation_shield_upgrade", "label": "Schild-Upgrade (4 Stufen, shieldPrices)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "08.10.2026: kein Gratis-Schild; Stufen 1.500/20.000/45.000/90.000 erh\u00f6hen maxStrikes; verziehene Crashes zeigen keine Meldung, sondern ein Ring-Signal (RingSignals.heal)."}, {"id": "foundation_ring_signals", "label": "Der Ring als Signalspur (Farbrollen der Signale)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leo 08.10.2026: Ank\u00fcndigungen, Auszahlungen, verpasste Boni als Ring-Signal statt Text (Lichtlauf, Welle, Blitz, Plus-Zeichen, Spritzer); Gr\u00fcn Spieler, Limette Rush Hour, Amber Oberfl\u00e4che, Gold Gro\u00dfes/Verdientes, Blau Polizei, Violett Verbrecher; Nachts leuchten sie (HUD.bloom, nicht bei lowDetail); Museum erkl\u00e4rt Signale (museumSignal.ts)."}, {"id": "foundation_blame_rule", "label": "Wer ist schuld (einf\u00e4delndes Auto z\u00e4hlt)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "foundation_wrecks_rule", "label": "Was besch\u00e4digt ist, f\u00e4hrt nicht mehr (Takedown, Beschlagnahme)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leo 26.09.2026: auch der Pickup ist nicht mehr gepanzert (criminalMass, criminalWrecked); Geldtransporter wird bei jedem Crash zum Wrack, das Geld ist weg (LOST)."}, {"id": "foundation_explosives", "label": "Sprengstoff (Tanklaster, Milit\u00e4r-Truck, World.explode)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leo 27.09.2026: explodierender Tanker macht alles im Umkreis zum Wrack; Rauch ist der \u00dcbergang ins n\u00e4chste Level (SmokeCurtain)."}, {"id": "foundation_crash_physics", "label": "Crash-Physik und Blechschaden (CrashPhysics, CarArt)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starrk\u00f6rper-Sto\u00df am Kontaktpunkt, 30 % R\u00fcckprall, Reifenreibung ca. 0,8 g, Wracks verschwinden nach 2,2 s; Beulen und abrei\u00dfende Teile."}, {"id": "foundation_traffic_reacts", "label": "Verkehr reagiert (Fahrermodell drivers.ts)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reaktionszeit 0,5-1,5 s, Bremsen bis 0,9 g, Kettenunf\u00e4lle entstehen aus der Physik; Folgeunf\u00e4lle kosten nichts (chainCrashesCostStrikes)."}, {"id": "foundation_ai_traffic", "label": "KI-Verkehr (Bots, minRingBots, Seed-Zufall)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Im normalen Verkehr fahren alle gleich schnell, die KI verursacht nie einen Crash; ein Bot f\u00e4hrt erst raus, wenn sein Nachfolger drin ist (botExitNotice 1,5 s); Ausnahme Stau (jamLookahead, botJamPatience)."}, {"id": "foundation_ai_starvation_rule", "label": "KI verhungert nicht an der Linie (aiPatience, aiPushInGap)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leo 29.09.2026: Ohne die Regel konnte ein Dauerstrom von Spielerautos in Unlimited/Multiplayer alle KI-Arme aushungern, der Ring war leer und Dauertippen gefahrlos."}, {"id": "foundation_ring_modules", "label": "Module am Ring (6 Modulpl\u00e4tze, 3 Stufen)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "2.9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module verdienen ohne Tap Geld und kosten Fluss (Wirtschaft schafft Gefahr): Toll Booth, Speed Camera, Tow Depot, Billboard, Detour Sign; Abriss zahlt nichts zur\u00fcck."}, {"id": "foundation_game_tab_modes", "label": "Game-Tab-Modi (Shift, Unlimited, Mayhem, Multiplayer)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "Abschnitt 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "26.09.2026 ersetzen die Gefahrenstufe High Alert; Wischen schiebt die Karte zum n\u00e4chsten Modus mit Federn-Einrasten; Mayhem mit mayhemReload 1,1 s und Kettenreaktion; z\u00e4hlt nicht in Geld, Level oder Mastery."}, {"id": "foundation_screens", "label": "Screens und UI (flow.ts, kein Startmen\u00fc)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "Abschnitt 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Das Spiel \u00f6ffnet auf dem Game-Tab, ein Tap startet die Schicht; HUD und Ergebnis-Banner kommen aus der Render-Liste, nur schwebende Kn\u00f6pfe sind DOM."}, {"id": "foundation_architecture_layers", "label": "Drei Schichten (core, present, Plattform)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "core/ kennt kein DOM, nur so laufen Balancing-Bots und Tests in Node; die Plattform enth\u00e4lt keine Spiellogik."}, {"id": "foundation_render_list", "label": "Render-Liste und gebackene Ebenen", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "29.09.2026 Performance ohne Grafikverlust: Statisches wird einmal gebacken (RenderList.markStatic/bake); ein bewegtes Bodendetail geh\u00f6rt hinter still(), sonst friert es ein; gebackene Strecke braucht Schl\u00fcssel."}, {"id": "foundation_game_loop", "label": "Game-Loop (world.step(1/120), Interpolation)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eingaben kommen mit Zeitstempel in die Simulation; das Timing bleibt bei 60, 120 oder 144 Hz gleich."}, {"id": "foundation_determinism", "label": "Determinismus (fester Zeitschritt + Seed)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Darauf bauen Challenge-Links, Multiplayer (Lockstep) und Replay-Tests."}, {"id": "foundation_paths", "label": "Fahrzeuge fahren auf Pfaden, nicht auf Winkeln", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mehrspurige Kreisverkehre, Stra\u00dfennetz-Editor und Zollstellen sind dann nur neue Pfade und keine neue Logik."}, {"id": "foundation_collision", "label": "Kollision per Kapseln, keine Physik-Engine", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kollision ist Spiellogik, muss in Node testbar sein und exakte Abst\u00e4nde f\u00fcr Tight Fit liefern; gepr\u00fcft wird nur wo n\u00f6tig; bei 120 Hz kein Tunneln."}, {"id": "foundation_docking_points", "label": "Andockpunkte f\u00fcr sp\u00e4tere Systeme", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "4.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VehicleType, World.dispatchPolice(), onMerged-Hooks, drivers.ts, forLevel, neue Seiten in flow.ts, Events steuern adaptive Musik, Seed + Eingaben als Replay."}, {"id": "foundation_decisions", "label": "Entscheidungen (Abschnitt 7)", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "Abschnitt 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browserspiel, Hochformat, native Anmutung, echte Crash-Physik, Ergebnis ohne Men\u00fc, kein Startmen\u00fc, Schicht ohne feste Zeit, 1 Strike + 3 Polizei-Crashes."}, {"id": "foundation_playtest_questions", "label": "Offen f\u00fcr den Playtest", "file_type": "concept", "source_file": "FOUNDATION.md", "source_location": "Abschnitt 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tight-Fit-Schwelle 0,12 s, sloppyWindow, Autozahl, Einf\u00e4deldauer, Combo-Stufen, Folgeunfall-Strikes (Ring.answerable entschieden 10.10.2026), Wrack-Dauer crashDuration."}, {"id": "foundation_core_config_ts", "label": "core/config.ts (alle Startwerte)", "file_type": "code", "source_file": "FOUNDATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "foundation_core_drivers_ts", "label": "core/drivers.ts (Fahrermodell)", "file_type": "code", "source_file": "FOUNDATION.md", "source_location": "2.6", "source_url": null, "cap