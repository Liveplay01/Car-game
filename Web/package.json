{
  "name": "car-game-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web port of the roundabout timing game: one tap sends the front car into the ring.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node --test-reporter=spec scripts/test.mjs",
    "sim": "node scripts/sim.mjs",
    "sim:versus": "node scripts/versus-sim.mjs",
    "sim:casino": "node scripts/casino-sim.mjs",
    "sim:career": "node scripts/career-sim.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  }
}
